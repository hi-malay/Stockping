# @BotFather -> /newbot -> paste the token here
TELEGRAM_BOT_TOKEN=

# your telegram chat id — prefilled in the UI (npm run chatid fills this)
DEFAULT_TELEGRAM_CHAT_ID=

# The store — stockping.json in the portfolio-data repo. Required, there is no local
# fallback: the Vercel UI and the GCP cron both read and write this one file.
# Token: PAT with Contents read & write on hi-malay/portfolio-data
GITHUB_TOKEN=
GITHUB_REPO=hi-malay/portfolio-data
STORE_PATH=stockping.json

# optional: override the cron for testing, e.g. "*/2 * * * *"
# CRON=*/30 * * * *
